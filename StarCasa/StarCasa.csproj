<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Assembly information -->
    <ApplicationIcon>StarCasa.ico</ApplicationIcon>
    <Authors>Richard Lawrence</Authors>
    <Product>StarCasa</Product>
    <Description>Generate a report of starred photos in Picasa</Description>
    <AssemblyTitle>Generate a report of starred photos in Picasa</AssemblyTitle>
    <PackageProjectUrl>https://github.com/mrsilver76/starcasa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mrsilver76/starcasa</RepositoryUrl>
    <Copyright>Copyright © 2025 Richard Lawrence</Copyright>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Version information -->
    <!-- Remember major.minor.BUILD.revision! -->
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="StarCasa.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ini-parser" Version="2.5.2" NoWarn="NU1701" />
  </ItemGroup>

</Project>
